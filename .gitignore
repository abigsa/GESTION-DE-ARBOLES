# ============================================================
# .gitignore — Gestión de Árboles
# Backend: Node.js + Express + Oracle
# Frontend: React (Create React App)
# ============================================================


# ── Credenciales y configuración sensible ───────────────────
.env
.env.local
.env.development
.env.production
*.pem
*.key


# ── Dependencias ────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/


# ── Build del frontend ───────────────────────────────────────
frontend/build/
frontend/dist/


# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/


# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini


# ── Editores e IDEs ──────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln


# ── Oracle / SQL Developer ───────────────────────────────────
*.dmp
*.log
spool*.sql


# ── Archivos temporales ──────────────────────────────────────
*.tmp
*.temp
*.swp
